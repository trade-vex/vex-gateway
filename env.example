# Vex Gateway Environment Variables
# Copy this file to .env and update the values as needed

# Application Environment
APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database Configuration
DATABASE_URL=postgres://vex_user:vex_password@localhost:5432/vex_gateway
DATABASE_MAX_CONNECTIONS=10

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNECTIONS=10

# JWT Configuration
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ISSUER=vex-gateway
JWT_AUDIENCE=api
JWT_ACCESS_TOKEN_TTL_MINUTES=60
JWT_REFRESH_TOKEN_TTL_DAYS=7

# OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Email Configuration
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=noreply@vex-gateway.com
SMTP_PASSWORD=password
FROM_EMAIL=noreply@vex-gateway.com

# Logging Configuration
LOG_LEVEL=debug
LOG_STRUCTURED=false
LOG_COLORED=true

# Security Configuration
API_KEY_RATE_LIMIT=1000
API_KEY_RATE_WINDOW=3600
JWT_ALGORITHM=RS256

# Development Configuration
DEBUG=true
HOT_RELOAD=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
