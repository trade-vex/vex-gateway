# Local development configuration for the docker-compose services used by scripts/.
# scripts/setup_dev.sh copies this file to config/development.toml (gitignored); edit the copy.
# Every setting below is required unless marked optional. Run from the repository root.
environment = "development"

[server]
host = "127.0.0.1"
port = 8081

# The internal listener for GET /metrics (Prometheus text format): an IP address and a port. Bind it
# where only the metrics scraper reaches it, never the load balancer; production requires a port of
# its own. Override with APP__METRICS__BIND.
[metrics]
bind = "127.0.0.1:9091"

# The API's rate limits, counted in Redis (auth.redis.url): each budget allows each caller
# max_requests per window of window_seconds, then answers 429 with Retry-After until the window
# ends. A caller is the authenticated user (the JWT's, or the API key's owner); an anonymous caller
# is its client IP (an IPv6 client its /64). Every setting must be greater than 0. Override with
# APP__RATE_LIMIT__<BUDGET>__<KEY>, e.g. APP__RATE_LIMIT__ORDERS__MAX_REQUESTS.
# Placing orders: POST /api/order.
[rate_limit.orders]
max_requests = 100
window_seconds = 10

# Every other route that has no limit of its own, POST /api/cancel included, so that a caller over
# the orders budget can still cancel its resting orders.
[rate_limit.general]
max_requests = 600
window_seconds = 60

[logging]
level = "debug"

[auth.jwt]
private_key_path = "crates/libs/lib-auth/src/keys/private_key.pem"
public_key_path = "crates/libs/lib-auth/src/keys/public_key.pem"
access_token_ttl_minutes = 60
refresh_token_ttl_days = 30
issuer = "vex-gateway-dev"
audience = "vex-api-dev"

[auth.database]
url = "postgresql://postgres:postgres123@localhost:5432/trading_db"

[auth.redis]
url = "redis://127.0.0.1:6380"

[auth.oauth]
providers = {}
redirect_base = "http://localhost:8081"
# Where a completed OAuth login lands: required once a provider is configured.
# frontend_url_web = "http://localhost:3000"
# frontend_url_app = "vex://oauth"

[auth.server]
# Optional; empty means clients connect directly. Required in production.
# trusted_proxies = ["10.0.1.0/24"]

[auth.email]
smtp_host = "smtp.example.com"
smtp_port = 587
smtp_username = "user@example.com"
smtp_password = "password"
from_email = "noreply@example.com"

[auth.otp]
otp_length = 6
email_verification_expiry_minutes = 15

# ClickHouse, which serves the portfolio and balance-chart reads. Override with APP__CLICKHOUSE__URL.
[clickhouse]
url = "http://localhost:8123"

# The Aeron link to vex-core. Override a key with APP__CORE__<KEY>, e.g. APP__CORE__AUTH_KEY.
[core]
# This gateway's id at the core: 0-15, unique among the gateways connected to it.
gateway_id = 1
# Handshake credential: a signed 32-bit integer equal to vex-core's
# VEX__GATEWAY_NETWORKING__GATEWAY_AUTHENTICATION_KEY. Empty only for a core running without
# authentication; required in production.
auth_key = ""
address = "aeron-media-driver-core"
# = vex-core core_networking.initial_port / initial_control_port (3521/3522 in production,
# 40001/40002 for vex-core's development and test defaults). The two must differ.
port = 3521
control_port = 3522
# This gateway's Aeron media driver directory.
context_dir = "/dev/shm/aeron"
