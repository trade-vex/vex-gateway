{
  "connector.class": "com.clickhouse.kafka.connect.ClickHouseSinkConnector",
  "tasks.max": "3",
  "topics": "balances,orders,orderbook,cancels,trades,deposits,withdrawals",
  "topic2TableMap": "balances=balance_events,orders=order_events,orderbook=orderbook_events,cancels=cancel_events,trades=trade_events,deposits=deposit_events,withdrawals=withdrawal_events",
  "hostname": "${file:/etc/vex-connect/clickhouse.properties:hostname}",
  "port": "${file:/etc/vex-connect/clickhouse.properties:port}",
  "database": "${file:/etc/vex-connect/clickhouse.properties:database}",
  "username": "${file:/etc/vex-connect/clickhouse.properties:username}",
  "password": "${file:/etc/vex-connect/clickhouse.properties:password}",
  "ssl": "true",
  "jdbcConnectionProperties": "?sslrootcert=/etc/vex-connect/clickhouse-ca.pem",
  "exactlyOnce": "false",
  "errors.tolerance": "none",
  "retryOnSocketException": "true",
  "transforms": "flatten,event_ts,order_event_ts",
  "transforms.flatten.type": "org.apache.kafka.connect.transforms.Flatten$Value",
  "transforms.flatten.delimiter": "_",
  "transforms.event_ts.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
  "transforms.event_ts.renames": "timestamp:event_ts",
  "transforms.order_event_ts.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
  "transforms.order_event_ts.renames": "order_timestamp:event_ts",
  "transforms.order_event_ts.predicate": "orders",
  "predicates": "orders",
  "predicates.orders.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.orders.pattern": "orders"
}
