{
  "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
  "tasks.max": "3",
  "topics": "balances",
  "connection.url": "jdbc:postgresql://${file:/etc/vex-connect/postgres.properties:server}/${file:/etc/vex-connect/postgres.properties:database}?sslmode=verify-full&sslrootcert=/etc/vex-connect/postgres-ca.pem&loginTimeout=10&socketTimeout=15",
  "connection.user": "${file:/etc/vex-connect/postgres.properties:user}",
  "connection.password": "${file:/etc/vex-connect/postgres.properties:password}",
  "connection.attempts": "7",
  "connection.backoff.ms": "30000",
  "table.name.format": "trading.balance_events",
  "insert.mode": "upsert",
  "pk.mode": "record_value",
  "pk.fields": "user_id,asset_id,event_ts",
  "auto.create": "false",
  "auto.evolve": "false",
  "transforms": "flatten,event_ts",
  "transforms.flatten.type": "org.apache.kafka.connect.transforms.Flatten$Value",
  "transforms.flatten.delimiter": "_",
  "transforms.event_ts.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
  "transforms.event_ts.renames": "timestamp:event_ts",
  "errors.tolerance": "none",
  "max.retries": "60",
  "retry.backoff.ms": "10000"
}
