# Environment variables for local development testing
# Copy this file to .env in the project root

# Application Environment
APP_ENV=development

# Server Configuration
APP_SERVER_HOST=127.0.0.1
APP_SERVER_PORT=8081

# Database Configuration
DATABASE_URL=postgresql://vex:1234@localhost:5432/vex_gateway
DATABASE_MAX_CONNECTIONS=10

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379
REDIS_MAX_CONNECTIONS=10

# JWT Configuration
JWT_PRIVATE_KEY_PATH=crates/libs/lib-auth/src/keys/private_key.pem
JWT_PUBLIC_KEY_PATH=crates/libs/lib-auth/src/keys/public_key.pem
JWT_ISSUER=vex-gateway-dev
JWT_AUDIENCE=vex-api-dev

# Email Configuration (for testing - using fake SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=test@example.com
SMTP_PASSWORD=password
FROM_EMAIL=noreply@vex-gateway.dev

# OTP Configuration
OTP_LENGTH=6
EMAIL_VERIFICATION_EXPIRY_MINUTES=15

# Server Base URL
BASE_URL=http://localhost:8081

# OAuth Configuration (empty for development)
# Add OAuth providers here if needed for testing
# OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
# OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret
# OAUTH_GITHUB_CLIENT_ID=your_github_client_id
# OAUTH_GITHUB_CLIENT_SECRET=your_github_client_secret
