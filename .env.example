# Environment variables for local development testing
# Copy this file to .env in the project root. Nothing reads .env itself: export it into the
# shell that runs the gateway or the tests (for example `set -a; . ./.env; set +a`).
# The gateway's database, Redis, JWT, email and OAuth settings live in config/<env>.toml.

# Application Environment
APP_ENV=development

# Server Configuration
APP__SERVER__HOST=127.0.0.1
APP__SERVER__PORT=8081

# Postgres for the database-backed tests (the gateway itself uses auth.database.url)
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/trading_db

# Redis for the Redis-backed tests (the gateway itself uses auth.redis.url)
REDIS_URL=redis://127.0.0.1:6380
